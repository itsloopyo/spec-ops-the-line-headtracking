# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Source code
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Windows batch/cmd scripts (require CRLF)
*.cmd text eol=crlf
*.bat text eol=crlf

# Config files
*.cfg text eol=lf
*.conf text eol=lf
*.ini text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (do not normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.asi binary
*.pdb binary
*.lib binary
